# Copy to .env and adjust. Every value is optional; defaults work for local development.
DATABASE_URL=sqlite:///./teaching.db
# At least 32 characters. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_EXPIRE_MINUTES=10080
SEED_DEMO_DATA=true
# Comma-separated origins allowed for browser clients, or * for any.
CORS_ORIGINS=*
